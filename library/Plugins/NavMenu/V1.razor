@namespace IdeaCms.Plugin.NavMenu
@inherits PluginBase
@attribute [Idea(DisplayName = "Nav Menu")]

@* IdeaCms.Plugin.NavMenu.V1 — the site navigation bar. Links come from the placement's
   links="Text=/href;Text=/href" attribute, falling back to the site setting "nav.links" (Host ->
   Site -> Page override chain), so one theme can carry the token while every SITE supplies its own
   menu — the multi-site seam. Brand text/href work the same way ("nav.brand" / "nav.brandhref").
   The current page's slug gets aria-current. Collapses to a hamburger below 720px (navmenu.js). *@
<link rel="stylesheet" href="/_ideas/Plugin/navmenu/1/navmenu.css" />
<script src="/_ideas/Plugin/navmenu/1/navmenu.js" defer></script>
<nav class="ma-header @CssClass" aria-label="Site" style="@_outerStyle">
    <a class="ma-header-brand" href="@_brandHref">@_brand</a>
    <button class="ma-header-toggle" type="button" aria-label="Menu" aria-expanded="false">
        <span></span><span></span><span></span>
    </button>
    <ul class="ma-header-list">
        @foreach (var (text, href) in _links)
        {
            <li class="ma-header-list-item">
                <a class="ma-header-link" href="@href" aria-current="@(IsCurrent(href) ? "page" : null)">@text</a>
            </li>
        }
    </ul>
</nav>

@code {
    /// <summary>Menu entries as "Text=/href;Text=/href". Overrides the "nav.links" site setting.</summary>
    [Parameter, Setting("Links", Group = "Content", Copyable = false, Description = "Text=/href;Text=/href")] public string? Links { get; set; }

    /// <summary>Brand text shown at the left. Overrides the "nav.brand" site setting.</summary>
    [Parameter, Setting("Brand text", Group = "Content", Copyable = false)] public string? Brand { get; set; }

    /// <summary>Brand link target (default "/"). Overrides the "nav.brandhref" site setting.</summary>
    [Parameter, Setting("Brand link", Group = "Content", Copyable = false)] public string? BrandHref { get; set; }

    /// <summary>Additional CSS classes appended to the root element.</summary>
    [Parameter, Setting("Extra CSS classes", Group = "Advanced")] public string? CssClass { get; set; }

    /// <summary>Inline CSS appended to the root element's style attribute.</summary>
    [Parameter, Setting("Extra inline style", Group = "Advanced")] public string? CssStyle { get; set; }

    /// <summary>CSS padding shorthand (e.g. "1rem" or "4px 8px").</summary>
    [Parameter, Setting("Padding", Group = "Layout", Order = 1)] public string? Padding { get; set; } = ".75rem 1rem";

    /// <summary>CSS margin shorthand.</summary>
    [Parameter, Setting("Margin", Group = "Layout", Order = 2)] public string? Margin { get; set; }

    /// <summary>Text-align or flex justification (e.g. "center", "left", "right").</summary>
    [Parameter, Setting("Alignment", Group = "Layout", Order = 3)] public string? Align { get; set; }

    private string _outerStyle => string.Join(";", new[]
    {
        string.IsNullOrEmpty(Padding) ? null : $"padding:{Padding}",
        string.IsNullOrEmpty(Margin)  ? null : $"margin:{Margin}",
        string.IsNullOrEmpty(Align) ? null : $"text-align:{Align}",
        CssStyle,
    }.Where(s => s is not null));

    private IReadOnlyList<(string Text, string Href)> _links = Array.Empty<(string, string)>();
    private string _brand = "";
    private string _brandHref = "/";

    protected override void OnParametersSet()
    {
        var site = Context?.Site;
        _brand = FirstNonEmpty(Brand, site?.GetSetting("nav.brand"), site?.Key) ?? "Home";
        _brandHref = SafeUrl(FirstNonEmpty(BrandHref, site?.GetSetting("nav.brandhref")) ?? "/");
        _links = ParseLinks(FirstNonEmpty(Links, site?.GetSetting("nav.links")));
    }

    private bool IsCurrent(string href) =>
        Context?.Page is { } p && href.Trim('/').Equals(p.Slug.Trim('/'), StringComparison.OrdinalIgnoreCase);

    private static string? FirstNonEmpty(params string?[] values) =>
        values.FirstOrDefault(v => !string.IsNullOrWhiteSpace(v));

    // "Home=/;About=/about" -> [(Home, /), (About, /about)]. Tolerant: skips malformed pairs.
    private static IReadOnlyList<(string, string)> ParseLinks(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return Array.Empty<(string, string)>();
        var list = new List<(string, string)>();
        foreach (var pair in raw.Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            var eq = pair.IndexOf('=');
            if (eq <= 0 || eq == pair.Length - 1) continue;
            var href = pair[(eq + 1)..].Trim();
            if (IsUnsafeUrl(href)) continue;
            list.Add((pair[..eq].Trim(), href));
        }
        return list;
    }
}

@using Microsoft.AspNetCore.Http
@using Microsoft.EntityFrameworkCore
@using MindAttic.Ideas.Core.Data
@using MindAttic.Ideas.Core.Sites
@inject IDbContextFactory<CmsDbContext> DbFactory
@inject ISiteResolver SiteResolver
@inject IHttpContextAccessor Http
<!DOCTYPE html>
<html lang="en" data-theme-mode="@_themeMode">

<head>
    @* Must stay the first thing in <head>, ahead of every stylesheet: theme-init.js sets
       data-theme-mode from the visitor's own saved choice (if any) before the theme CSS below ever
       paints, so there's no flash of the wrong mode. The server-rendered attribute above is only the
       first-visit default.
       No inline <script> anywhere in this shell: /login, /mfa and /account render through it with
       MindAttic.Authentication's strict CSP (script/style 'self' + a per-request nonce), which blocks
       inline scripts. The one generated inline script, the import map, carries that nonce (M.IDEA-T36). *@
    <script src="js/theme-init.js"></script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["MindAttic.Ideas.Blazor.styles.css"]" />
    <ImportMap nonce="@_cspNonce" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    @* MindAttic.UiUx auth-visual components (synced to wwwroot/js by sync-ideas.ps1). CSS arrives
       via the app.css marker blocks already linked above. *@
    <script src="js/admin-monaco.js"></script>
    <script src="js/user-login.js"></script>
    <script src="js/user-circle.js"></script>
    <script src="js/user-timeout.js"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    private string _themeMode = "light";

    // The auth surface's per-request CSP nonce (null elsewhere, so the attribute is omitted there).
    private string? _cspNonce;

    protected override async Task OnInitializedAsync()
    {
        _cspNonce = Http.HttpContext?.Items[MindAttic.Authentication.Web.MindAtticAuthAppExtensions.CspNonceItem] as string;

        // Best-effort: this is only the pre-localStorage first-visit default (see js/theme-init.js
        // above), so any failure here just falls back to "light" rather than breaking the page.
        try
        {
            var host = Http.HttpContext?.Request.Host.Value;
            await using var db = await DbFactory.CreateDbContextAsync();
            var site = await SiteResolver.ResolveAsync(host, db);
            _themeMode = site?.DefaultThemeMode == "dark" ? "dark" : "light";
        }
        catch
        {
            _themeMode = "light";
        }
    }
}

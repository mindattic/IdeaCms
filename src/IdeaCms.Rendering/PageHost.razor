@page "/{*Slug}"
@namespace IdeaCms.Rendering
@*  One interactive circuit per content page: any stamped widget that needs interactivity (e.g. a
    LegionPersonas gallery) is live, sharing this ONE circuit — no per-widget app pool. PageHost is the
    interactive ROOT, so only its route param (Slug, a string) crosses the serialization boundary; the
    IRenderContext cascade + RenderFragment body it builds internally never serialize. (Future perf
    refinement: per-island render mode for purely-static pages — needs a serializable cascade first.) *@
@rendermode InteractiveServer
@implements IDisposable
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MindAttic.Authentication
@using IdeaCms.Core.Data
@using IdeaCms.Core.Entities
@using IdeaCms.Core.Services
@using IdeaCms.Core.Sites
@inject IDbContextFactory<CmsDbContext> DbFactory
@inject ISlugRedirectService SlugRedirects
@inject ISiteResolver SiteResolver
@inject IContentCatalog Catalog
@inject IServiceProvider Services
@inject IRenderAlertSink Alerts
@inject NavigationManager Nav
@inject IHttpContextAccessor Http
@inject PersistentComponentState AppState

@* The single, permanent render entry point for free-form pages. No zones. Resolution is by
   (SiteId, Slug) data lookup, never per-page routing — so a runtime-loaded type renders unchanged. *@

@* HeadContent is always rendered. CSS fields are pre-populated via PersistentComponentState so the
   interactive circuit's first render restores the SSR head rather than blanking it. *@
<HeadContent>
    @if (_context is not null && _context.Page.Meta.GetValueOrDefault("seo.description") is { Length: > 0 } desc)
    {
        <meta name="description" content="@desc" />
    }
    <CmsHead GlobalCss="@_globalCss"
             ThemeGlobalCss="@_themeGlobalCss"
             ThemeCss="@_themeCss"
             ThemeScripts="@_themeScripts"
             ComponentCss="@_componentCss"
             ComponentScripts="@_componentScripts" />
</HeadContent>

@if (_status == Status.NotFound)
{
    <PageTitle>Not found</PageTitle>
    <p class="ma-404">Page not found.</p>
}
else if (_status == Status.Forbidden)
{
    <PageTitle>Not found</PageTitle>
    <p class="ma-404">Page not found.</p>
}
else if (_context is not null)
{
    <PageTitle>@(_context.Page.SeoTitle ?? _context.Page.Title)</PageTitle>

    <CascadingValue Value="_context" IsFixed="true">
        @if (_themeType is not null)
        {
            @* Plugins render INSIDE the theme's Body hole (see _themeParams) so .page wraps everything. *@
            <DynamicComponent Type="_themeType" Parameters="_themeParams" />
        }
        else
        {
            @foreach (var pt in _pluginTypesBeforeBody)
            {
                <DynamicComponent Type="pt" Parameters="PluginParams(pt)" />
            }
            <DynamicComponent Type="_bodyType" Parameters="_bodyParams" />
            @foreach (var pt in _pluginTypesAfterBody)
            {
                <DynamicComponent Type="pt" Parameters="PluginParams(pt)" />
            }
        }
    </CascadingValue>

    @if (_adminPageId is int adminPageId)
    {
        @* Admin-only, invisible until hovered: jumps to this page's configuration in Admin. Styled inline
           (not by any theme/plugin CSS) so no page's cascade can hide or restyle it. *@
        <a class="ma-admin-cog" href="/admin/pages?page=@adminPageId" title="Configure this page in Admin"
           aria-label="Configure this page in Admin" data-enhance-nav="false"
           style="position:fixed;left:.6rem;bottom:.6rem;z-index:2147483000;width:2.25rem;height:2.25rem;display:flex;align-items:center;justify-content:center;border-radius:50%;font-size:1.35rem;line-height:1;text-decoration:none;color:#fff;background:rgba(0,0,0,.55);opacity:0;transition:opacity .15s ease;"
           onmouseenter="this.style.opacity='1'" onmouseleave="this.style.opacity='0'"
           onfocus="this.style.opacity='1'" onblur="this.style.opacity='0'">⚙</a>
    }
}

@code {
    [Parameter] public string? Slug { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    /// <summary>A plugin's declared render slot, defaulting to BeforeBody when it declares none.</summary>
    private static PluginSlot SlotOf(Type t) =>
        t.GetCustomAttributes(typeof(IdeaAttribute), inherit: false) is [IdeaAttribute a, ..]
            ? a.Slot
            : PluginSlot.BeforeBody;

    /// <summary>A page plugin's stored instance settings as render parameters (M.IDEA-§4.5); empty when none.</summary>
    private IDictionary<string, object>? PluginParams(Type t) => _pluginParams.GetValueOrDefault(t);

    /// <summary>The "host[:port]" of an absolute URI, or null if it cannot be parsed.</summary>
    private static string? HostOf(string? absoluteUri) =>
        Uri.TryCreate(absoluteUri, UriKind.Absolute, out var u) ? u.Authority : null;

    /// <summary>
    /// Drop everything the LAST page put on this circuit. PageHost is a long-lived route component, so on
    /// an in-circuit navigation every field below still holds the previous page's value — and
    /// &lt;HeadContent&gt; renders unconditionally, outside the _status switch. Without this reset a 404
    /// (or a Forbidden) kept serving the previous page's theme stylesheets, hoisted component css/js and
    /// meta description; on the Forbidden path that also named the citizens of a restricted page to a
    /// viewer who is not allowed to see it. Every early return from OnParametersSetAsync calls this.
    /// </summary>
    private void ClearPageState()
    {
        _adminPageId = null;
        _context = null;
        _themeType = null;
        _themeParams = null;
        _bodyType = typeof(FreeFormPage);
        _pluginTypesBeforeBody = [];
        _pluginTypesAfterBody = [];
        _pluginParams = [];
        _bodyParams = null;
        _themeGlobalCss = Array.Empty<string>();
        _themeCss = Array.Empty<string>();
        _themeScripts = Array.Empty<string>();
        _componentCss = Array.Empty<string>();
        _componentScripts = Array.Empty<string>();
    }

    /// <summary>A slot's stored JSON as parameters for <paramref name="type"/>, or null when it sets nothing.</summary>
    private static IDictionary<string, object>? BindSlot(Type type, string? json)
    {
        var bound = InstanceSettingsBinder.ToParameters(type, json);
        return bound.Count == 0 ? null : bound.ToDictionary(kv => kv.Key, kv => kv.Value!);
    }

    private enum Status { Pending, Ok, NotFound, Forbidden }
    private Status _status = Status.Pending;

    private IRenderContext? _context;
    private Type? _themeType;
    private Type _bodyType = typeof(FreeFormPage);
    private IDictionary<string, object>? _themeParams;
    private IReadOnlyList<Type> _pluginTypesBeforeBody = [];
    private IReadOnlyList<Type> _pluginTypesAfterBody = [];
    private Dictionary<Type, IDictionary<string, object>> _pluginParams = [];
    private int? _adminPageId;
    private IDictionary<string, object>? _bodyParams;
    private string? _globalCss;
    private IReadOnlyList<string> _themeGlobalCss = Array.Empty<string>();
    private IReadOnlyList<string> _themeCss = Array.Empty<string>();
    private IReadOnlyList<string> _themeScripts = Array.Empty<string>();
    private IReadOnlyList<string> _componentCss = Array.Empty<string>();
    private IReadOnlyList<string> _componentScripts = Array.Empty<string>();

    private PersistingComponentStateSubscription _persistSub;

    // Restore CSS state saved during SSR prerender so the first interactive render
    // has the head already populated, preventing the layout shift.
    protected override void OnInitialized()
    {
        _persistSub = AppState.RegisterOnPersisting(PersistHeadState);

        if (AppState.TryTakeFromJson<string[]>("ph-css", out var css) && css is not null)
            _componentCss = css;
        if (AppState.TryTakeFromJson<string[]>("ph-scripts", out var scripts) && scripts is not null)
            _componentScripts = scripts;
        if (AppState.TryTakeFromJson<string[]>("ph-theme-css", out var tcss) && tcss is not null)
            _themeCss = tcss;
        if (AppState.TryTakeFromJson<string[]>("ph-theme-global-css", out var tgcss) && tgcss is not null)
            _themeGlobalCss = tgcss;
        if (AppState.TryTakeFromJson<string[]>("ph-theme-scripts", out var tscripts) && tscripts is not null)
            _themeScripts = tscripts;
        if (AppState.TryTakeFromJson<string?>("ph-global-css", out var gcss))
            _globalCss = gcss;
    }

    private Task PersistHeadState()
    {
        AppState.PersistAsJson("ph-css", _componentCss.ToArray());
        AppState.PersistAsJson("ph-scripts", _componentScripts.ToArray());
        AppState.PersistAsJson("ph-theme-css", _themeCss.ToArray());
        AppState.PersistAsJson("ph-theme-global-css", _themeGlobalCss.ToArray());
        AppState.PersistAsJson("ph-theme-scripts", _themeScripts.ToArray());
        AppState.PersistAsJson("ph-global-css", _globalCss);
        return Task.CompletedTask;
    }

    public void Dispose() => _persistSub.Dispose();

    protected override async Task OnParametersSetAsync()
    {
        var slug = (Slug ?? "").Trim('/').ToLowerInvariant();

        // Reserved prefixes never resolve to a content page (defense in depth; /admin & /_* are also
        // handled by endpoint routing).
        if (slug.StartsWith("admin", StringComparison.OrdinalIgnoreCase) || slug.StartsWith('_'))
        {
            ClearPageState();
            _status = Status.NotFound;
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        // Which domain was asked for. NavigationManager — not IHttpContextAccessor — because this
        // component is InteractiveServer: HttpContext exists during prerender and is NULL for every
        // render after the circuit connects, so reading the host from it would resolve the right site
        // on first paint and the DEFAULT site on every subsequent navigation. BaseUri is set from the
        // originating request and stays correct for the life of the circuit.
        var requestHost = HostOf(Nav.BaseUri) ?? Http.HttpContext?.Request.Host.Value;
        var site = await SiteResolver.ResolveAsync(requestHost, db);
        var siteId = site?.Id;

        // The bare route never renders content itself — it forwards to this site's front page. The
        // Site-scope setting wins over the Host-scope one so each domain can have its own landing
        // page; absent both, the conventional "frontpage" slug. During prerender the
        // NavigationException this raises is converted by the framework into an HTTP redirect.
        if (slug.Length == 0)
        {
            var siteFp = siteId is null ? null : await db.Settings.FirstOrDefaultAsync(
                s => s.Scope == "Site" && s.ScopeId == siteId && s.Key == "page.frontpage");
            var hostFp = await db.Settings.FirstOrDefaultAsync(s => s.Scope == "Host" && s.Key == "page.frontpage");
            var fp = !string.IsNullOrWhiteSpace(siteFp?.Value) ? siteFp!.Value : hostFp?.Value;
            Nav.NavigateTo("/" + (string.IsNullOrWhiteSpace(fp) ? "frontpage" : fp!.Trim('/')), replace: true);
            return;
        }

        var page = await db.Pages.Include(p => p.MetaTags).FirstOrDefaultAsync(p =>
            p.SiteId == siteId && p.Slug == slug && p.IsPublished && p.Enabled);

        if (page is null)
        {
            // Before showing 404, check if this slug was renamed and a redirect entry exists.
            var redirect = await SlugRedirects.CheckRedirectAsync(siteId, slug);
            if (redirect is not null)
            {
                // Emit the status the redirect actually declares (301 for a rename). NavigateTo can only
                // ever produce a 302, which tells search engines the OLD url is still the canonical one —
                // exactly wrong for a permanent rename. Fall back to it only once the response has started.
                var http = Http.HttpContext;
                if (http is not null && !http.Response.HasStarted)
                {
                    http.Response.StatusCode = redirect.StatusCode;
                    http.Response.Headers.Location = "/" + redirect.TargetSlug;
                    return;
                }
                Nav.NavigateTo("/" + redirect.TargetSlug, forceLoad: true);
                return;
            }
            ClearPageState();
            _status = Status.NotFound;
            return;
        }

        // Access control: if the page is restricted, verify the viewer has permission.
        if (page.IsRestricted)
        {
            var authState = AuthState is not null ? await AuthState : null;
            var user = authState?.User;

            if (user?.Identity?.IsAuthenticated != true)
            {
                Nav.NavigateTo("/_ma-auth/login?returnUrl=/" + Uri.EscapeDataString(slug), forceLoad: true);
                return;
            }

            var userRoles = user.FindAll(ClaimTypes.Role).Select(c => c.Value).ToHashSet(StringComparer.OrdinalIgnoreCase);
            var userId = user.FindFirstValue("ma:uid");

            // Admins always have access.
            bool hasAccess = userRoles.Contains(MaRoles.Admin);

            if (!hasAccess)
            {
                var allowedRoles = await db.PageRoleAccess.Where(x => x.PageId == page.Id)
                    .Select(x => x.RoleName).ToListAsync();

                // Auth role match (all role claims, case-insensitive).
                if (allowedRoles.Any(r => userRoles.Contains(r)))
                    hasAccess = true;

                // CMS role match.
                if (!hasAccess && userId is not null)
                {
                    var cmsRoleNames = await db.CmsUserRoles
                        .Where(ur => ur.UserId == userId)
                        .Join(db.CmsRoles, ur => ur.RoleId, r => r.Id, (ur, r) => r.Name)
                        .ToListAsync();
                    hasAccess = cmsRoleNames.Any(r => allowedRoles.Contains(r, StringComparer.OrdinalIgnoreCase));
                }

                // Per-user access.
                if (!hasAccess && userId is not null)
                    hasAccess = await db.PageUserAccess.AnyAsync(x => x.PageId == page.Id && x.UserId == userId);
            }

            if (!hasAccess)
            {
                ClearPageState();
                _status = Status.Forbidden;
                return;
            }
        }

        var inline = new CmsInlineMarkup
        {
            Html = page.BodyHtml,
            Css = page.PageCss,
            Js = page.PageJs,
            Trusted = page.BodyTrust == ContentTrust.Author,
        };
        var seoDict = page.MetaTags.ToDictionary(t => t.Name, t => (string?)t.Content);

        var pageCtx = new CmsPageContext
        {
            PageId = page.Uid, Slug = page.Slug, Title = page.Title, SeoTitle = page.SeoTitle,
            ThemeKey = page.ThemeKey, ThemeVersion = page.ThemeVersion, Inline = inline,
            Meta = seoDict,
        };
        var siteSettings = siteId.HasValue
            ? await db.Settings.Where(s => s.Scope == "Site" && s.ScopeId == siteId)
                  .ToDictionaryAsync(s => s.Key, s => s.Value)
            : new Dictionary<string, string?>();
        var siteCtx = new CmsSiteContext
        {
            SiteId = site?.Uid ?? Guid.Empty, Key = site?.Key ?? "default",
            // The host this request actually arrived on, so a citizen can build absolute URLs or
            // vary per domain. Empty only when neither the circuit nor an HttpContext knows it.
            Host = requestHost ?? "",
            DefaultThemeKey = site?.DefaultThemeKey ?? "",
            SettingReader = key => siteSettings.GetValueOrDefault(key),
        };
        // Per-instance settings for this page's theme / plugins / code-page body (M.IDEA-§4.5). A component's
        // settings live on its own tag in BodyHtml instead, so they never appear here.
        var slots = await db.WidgetPlacementSettings.Where(s => s.PageId == page.Id)
            .ToDictionaryAsync(s => s.SlotName, s => s.SettingsJson, StringComparer.OrdinalIgnoreCase);
        _context = new CmsRenderContext
        {
            InstanceId = Guid.NewGuid(), Mode = ContentMode.View, RenderMode = CmsRenderMode.InteractiveServer,
            Page = pageCtx, Site = siteCtx, Services = Services, RawSettingsJson = page.SettingsJson,
            InstanceSettings = slots,
        };

        // Body type: Data -> FreeFormPage; Code -> resolved type; unresolved -> placeholder.
        if (page.Kind == PageKind.Code && page.ComponentTypeName is not null)
        {
            // Prefer the CATALOG's descriptor for this compiled type: it carries the correct Origin
            // (Package vs Compiled), Category, Key, Version and AssetMount — so a PACKAGE page is loaded
            // through the collectible ALC. A bare inline descriptor defaults to Origin=Compiled (and an
            // empty Category), which the AlcAwareTypeResolver routes to the default resolver, so a package
            // page's type would never load and the page would degrade to the missing-page placeholder.
            var desc = Catalog.All.FirstOrDefault(d => d.Kind == ContentKind.Page
                          && string.Equals(d.ClrTypeName, page.ComponentTypeName, StringComparison.Ordinal))
                       ?? new ContentDescriptor
                          {
                              Kind = ContentKind.Page, Key = page.Slug, Version = 1, DisplayName = page.Title,
                              Strategy = RenderStrategy.ClrType, ClrTypeName = page.ComponentTypeName,
                              AssemblyName = page.AssemblyName ?? "",
                          };
            var resolvedBody = Catalog.ResolveType(desc);
            _bodyType = resolvedBody ?? typeof(MissingPageHost);
            if (resolvedBody is null)
            {
                // A Code page whose compiled type is missing/renamed -> placeholder + alert (never a crash).
                try { Alerts.RaiseMissing(ContentKind.Page, page.Slug, null, page.Uid, page.Slug); } catch { }
            }
        }
        else
        {
            _bodyType = typeof(FreeFormPage);
        }

        // Theme: page override -> site default -> null (floating/latest). Clear the previous page's
        // theme FIRST: PageHost is a long-lived route component, so on an in-circuit navigation these
        // fields still hold the last page's values. Without the reset a page that declares no theme
        // (and whose site has no default) rendered inside the previously visited page's theme, with
        // that theme's stylesheets still hoisted into <head>. (The early-return paths get the same
        // reset, plus the rest of the per-page state, from ClearPageState.)
        _themeType = null;
        _themeGlobalCss = Array.Empty<string>();
        _themeCss = Array.Empty<string>();
        _themeScripts = Array.Empty<string>();

        var themeKey = page.ThemeKey ?? site?.DefaultThemeKey;
        // The site's default VERSION belongs to the site's default KEY only: a page that names its own
        // theme without a version floats to that theme's latest, never to the site default's version.
        var themeVersion = page.ThemeKey is not null ? page.ThemeVersion : site?.DefaultThemeVersion;
        if (!string.IsNullOrWhiteSpace(themeKey))
        {
            var themeRes = Catalog.ResolveTag(ContentKind.Theme, themeKey!, themeVersion);
            if (themeRes.Outcome == ContentResolution.Resolved)
            {
                _themeType = themeRes.Type;
            }
            else
            {
                // Requested theme missing/disabled -> fall back to bootstrap, and surface an Admin Inbox
                // alert so the broken reference is never silent (the page still renders).
                var fallback = Catalog.FindLatest(ContentKind.Theme, "bootstrap");
                _themeType = fallback is null ? null : Catalog.ResolveType(fallback);
                try
                {
                    if (themeRes.Outcome == ContentResolution.Disabled)
                        Alerts.RaiseDisabled(ContentKind.Theme, themeKey!, themeVersion, page.Uid, page.Slug);
                    else
                        Alerts.RaiseMissing(ContentKind.Theme, themeKey!, themeVersion, page.Uid, page.Slug);
                }
                catch { /* alerting never breaks a render */ }
            }
        }

        if (_themeType is not null && Activator.CreateInstance(_themeType) is ThemeBase meta)
        {
            _themeGlobalCss = meta.GlobalCssUrls;
            _themeCss = meta.ThemeCssUrls;
            _themeScripts = meta.ScriptUrls;
        }

        // Resolve active plugins (selected via Admin Page Properties). Each plugin is a PluginBase citizen
        // that renders site-wide behavior before the body/theme; unresolved refs degrade to a warning in
        // Admin Inbox, never a crash. Inline {{Plugin.X}} tokens in BodyHtml are handled by IIncludeRenderer.
        // A page with no selection of its own inherits the site's default chrome, so every page in a site
        // gets its nav/footer without per-page bookkeeping. An explicit empty selection is still a choice —
        // but ActivePluginsJson serializes an empty list as null, so "none" is expressed by the fallback
        // being empty, not by an empty array.
        var pluginRefs = PageAdminService.EffectivePlugins(page.ActivePluginsJson, siteSettings.GetValueOrDefault("plugins.default"));
        _pluginParams = [];
        var pluginTypeList = new List<Type>(pluginRefs.Count);
        foreach (var pRef in pluginRefs)
        {
            var parsed = IncludeReferenceParser.ParseUses([pRef]);
            foreach (var (pk, pkey, pver) in parsed)
            {
                var pRes = Catalog.ResolveTag(pk, pkey, pver);
                if (pRes.Outcome == ContentResolution.Resolved && pRes.Type is not null)
                {
                    pluginTypeList.Add(pRes.Type);
                    var pParams = BindSlot(pRes.Type, slots.GetValueOrDefault(InstanceSlots.Plugin(pkey)));
                    if (pParams is not null) _pluginParams[pRes.Type] = pParams;
                }
                else
                {
                    try { Alerts.RaiseMissing(pk, pkey, pver, page.Uid, page.Slug); } catch { }
                }
            }
        }
        // A plugin declares its slot on the TYPE via [Idea(Slot = ...)], so this needs no instantiation.
        // Order within each slot follows the author's plugin selection.
        _pluginTypesBeforeBody = pluginTypeList.Where(t => SlotOf(t) == PluginSlot.BeforeBody).ToList();
        _pluginTypesAfterBody = pluginTypeList.Where(t => SlotOf(t) == PluginSlot.AfterBody).ToList();

        // Hoist + dedupe the head assets of the PACKAGE citizens this page includes (the no-schema
        // manifest->Extra data path feeds PageAssets.PackageAssetsOf; the collector + path are NUnit-tested
        // in Core). A DATA page's references come from its BodyHtml include tags; a CODE page has no BodyHtml,
        // so its references come from the manifest uses[] declared via [Uses] (surfaced onto the page
        // descriptor's Extra at reload). Both feed the SAME collector, so the head never disagrees with the
        // body about which citizen/version is on the page. Empty unless a citizen with assets is referenced.
        // Only Author-trust pages can embed component tags; Untrusted content must not trigger asset
        // hoisting for components that IncludeExpander will never render (skips upgrade for Untrusted).
        var refs = new List<(ContentKind, string, int?)>(
            page.BodyTrust == ContentTrust.Author
                ? IncludeReferenceParser.Parse(page.BodyHtml)
                : []);
        // Include active plugins in the asset collection so their css/js are hoisted too.
        refs.AddRange(IncludeReferenceParser.ParseUses(pluginRefs));
        if (page.Kind == PageKind.Code && page.ComponentTypeName is not null)
        {
            var pageDesc = Catalog.All.FirstOrDefault(d => d.Kind == ContentKind.Page
                && string.Equals(d.ClrTypeName, page.ComponentTypeName, StringComparison.Ordinal));
            if (pageDesc is not null)
                refs.AddRange(IncludeReferenceParser.ParseUses(ManifestAssetPacker.UsesFromExtra(pageDesc.Extra)));
        }
        var head = PageAssetCollector.Collect(refs, Catalog, d => PageAssets.AllAssetsOf(d, Catalog));
        _componentCss = head.Css;
        _componentScripts = head.Scripts;

        var globalSetting = await db.Settings.FirstOrDefaultAsync(s => s.Scope == "Host" && s.Key == "css.global");
        _globalCss = globalSetting?.Value;

        var bodyType = _bodyType;
        var bodyParams = page.Kind == PageKind.Code ? BindSlot(bodyType, slots.GetValueOrDefault(InstanceSlots.Page)) : null;
        _bodyParams = bodyParams;
        // The theme's single Body hole receives EVERYTHING on the page — BeforeBody plugins (header,
        // breadcrumbs), the body, then AfterBody plugins (footer) — so the theme's .page wrapper, and its
        // per-page padding/margin, frames the whole page rather than only the body.
        var before = _pluginTypesBeforeBody;
        var after = _pluginTypesAfterBody;
        var pluginParams = _pluginParams;
        void Plugin(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder b, Type pt)
        {
            b.OpenComponent(0, pt);
            if (pluginParams.GetValueOrDefault(pt) is { } pp)
                foreach (var kv in pp) b.AddComponentParameter(1, kv.Key, kv.Value);
            b.CloseComponent();
        }
        _themeParams = new Dictionary<string, object>
        {
            ["Body"] = (RenderFragment)(b =>
            {
                foreach (var pt in before) Plugin(b, pt);
                b.OpenComponent(2, bodyType);
                if (bodyParams is not null)
                    foreach (var kv in bodyParams) b.AddComponentParameter(3, kv.Key, kv.Value);
                b.CloseComponent();
                foreach (var pt in after) Plugin(b, pt);
            }),
        };
        if (_themeType is not null && BindSlot(_themeType, slots.GetValueOrDefault(InstanceSlots.Theme)) is { } themeSettings)
            foreach (var kv in themeSettings) _themeParams[kv.Key] = kv.Value;

        var viewer = AuthState is not null ? (await AuthState).User : null;
        _adminPageId = viewer?.Identity?.IsAuthenticated == true
                       && viewer.FindAll(ClaimTypes.Role).Any(c => string.Equals(c.Value, MaRoles.Admin, StringComparison.OrdinalIgnoreCase))
            ? page.Id : null;

        _status = Status.Ok;
    }
}

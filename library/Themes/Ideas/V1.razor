@namespace IdeaCms.Theme.Ideas
@inherits ThemeBase
@attribute [Idea(DisplayName = "IdeaCms")]

@* IdeaCms.Theme.Ideas.V1 — the CMS's own default theme: chrome (theme.css) + ONE @Body hole.
   Merges the former standalone Light and Dark themes into one theme with two WCAG 2.2 AA palettes,
   switched by the ThemeToggle plugin setting data-theme-mode="light"|"dark" on <html>. The light
   palette is the theme's native (undecorated) block in theme.css; the dark palette is an
   html[data-theme-mode="dark"] .theme-ideas override block. Scoped under .theme-ideas so it never
   leaks into widgets or other themes. Served at /_ideas/Theme/ideas/1/. *@
<div class="page theme-ideas @_modifiers" style="@_rootStyle">
    @Body
</div>

@code {
    private const string Mount = "/_ideas/Theme/ideas/1";
    public override IReadOnlyList<string> ThemeCssUrls { get; } = new[] { Mount + "/theme.css" };

    // ── Instance settings (M.IDEA-§4.5). Null = as designed; a value is emitted as a CSS custom property
    //    on this root element, which theme.css reads with the designed value as its fallback. A value
    //    set here applies to BOTH light and dark mode, overriding whichever palette is active. ──
    [Parameter, Setting("Page background", Group = "Colors", Order = 1, Description = "Full CSS background (color, gradient or url()); empty = the designed background")]
    public string? Background { get; set; }
    [Parameter, Setting("Background color token", Group = "Colors", Order = 2, Description = "--bg (designed: light #f6f7f9 / dark #0e1116)")]
    public string? BackgroundColor { get; set; }
    [Parameter, Setting("Surface color", Group = "Colors", Order = 3, Description = "--surface (designed: light #ffffff / dark #161b22)")]
    public string? SurfaceColor { get; set; }
    [Parameter, Setting("Text color", Group = "Colors", Order = 4, Description = "--text (designed: light #1b2230 / dark #e6edf3)")]
    public string? TextColor { get; set; }
    [Parameter, Setting("Muted text color", Group = "Colors", Order = 5, Description = "--muted (designed: light #5c6675 / dark #9aa6b2)")]
    public string? MutedColor { get; set; }
    [Parameter, Setting("Border / rule color", Group = "Colors", Order = 6, Description = "--line (designed: light #e3e7ee / dark #273039)")]
    public string? LineColor { get; set; }
    [Parameter, Setting("Accent color", Group = "Colors", Order = 7, Description = "--accent (designed: light #2563eb / dark #58a6ff)")]
    public string? AccentColor { get; set; }
    [Parameter, Setting("Text on accent", Group = "Colors", Order = 8, Description = "--accent-contrast (designed: light #ffffff / dark #0e1116)")]
    public string? AccentContrastColor { get; set; }
    [Parameter, Setting("Code background", Group = "Colors", Order = 9, Description = "--code-bg (designed: light #f0f2f6 / dark #1b222c)")]
    public string? CodeBackground { get; set; }
    [Parameter, Setting("Heading color", Group = "Colors", Order = 10, Description = "designed: light inherits the text color, dark #f0f6fc")]
    public string? HeadingColor { get; set; }
    [Parameter, Setting("Link color", Group = "Colors", Order = 11, Description = "designed: the accent")]
    public string? LinkColor { get; set; }
    [Parameter, Setting("Link hover color", Group = "Colors", Order = 12, Description = "designed: same as the link color")]
    public string? LinkHoverColor { get; set; }
    [Parameter, Setting("Button background", Group = "Colors", Order = 13, Description = "CSS background of buttons / .btn (designed: the accent)")]
    public string? ButtonBackground { get; set; }
    [Parameter, Setting("Font family", Group = "Typography", Order = 1, Description = "designed: system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif")]
    public string? FontFamily { get; set; }
    [Parameter, Setting("Base font size", Group = "Typography", Order = 2, Description = "designed: 16px")]
    public string? FontSize { get; set; }
    [Parameter, Setting("Line height", Group = "Typography", Order = 3, Description = "designed: 1.65")]
    public string? LineHeight { get; set; }
    [Parameter, Setting("Heading font family", Group = "Typography", Order = 4, Description = "designed: same as the body font")]
    public string? HeadingFontFamily { get; set; }
    [Parameter, Setting("Code font family", Group = "Typography", Order = 5, Description = "designed: Cascadia Code / JetBrains Mono / monospace")]
    public string? CodeFontFamily { get; set; }
    [Parameter, Setting("Content max width", Group = "Layout", Order = 3, Description = "Width of the reading column (designed: 860px)")]
    public string? ContentMaxWidth { get; set; }
    [Parameter, Setting("Content side padding", Group = "Layout", Order = 4, Description = "padding-inline of the reading column (designed: 1.25rem)")]
    public string? ContentGutter { get; set; }
    [Parameter, Setting("Button corner radius", Group = "Shape", Order = 1, Description = "designed: 8px")]
    public string? ButtonRadius { get; set; }
    [Parameter, Setting("Input corner radius", Group = "Shape", Order = 2, Description = "designed: 8px")]
    public string? InputRadius { get; set; }
    [Parameter, Setting("Code block corner radius", Group = "Shape", Order = 3, Description = "designed: 10px")]
    public string? BlockRadius { get; set; }
    [Parameter, Setting("Button hover effect", Group = "Behavior", Order = 1, Description = "Brighten buttons on hover (with a short transition)")]
    public bool ButtonHoverEffect { get; set; } = true;

    private string? _modifiers => string.Join(" ", new[] { (ButtonHoverEffect ? null : "theme-ideas--no-hover"), (string.IsNullOrWhiteSpace(HeadingFontFamily) ? null : "theme-ideas--heading-font"), (string.IsNullOrWhiteSpace(LinkHoverColor) ? null : "theme-ideas--link-hover") }.Where(c => c is not null));

    private string? _rootStyle
    {
        get
        {
            var parts = new List<string>();
            if (PageStyle is { } ps) parts.Add(ps);
            foreach (var (prop, value) in new (string, string?)[]
            {
                ("--theme-background", Background),
                ("--bg", BackgroundColor),
                ("--surface", SurfaceColor),
                ("--text", TextColor),
                ("--muted", MutedColor),
                ("--line", LineColor),
                ("--accent", AccentColor),
                ("--accent-contrast", AccentContrastColor),
                ("--code-bg", CodeBackground),
                ("--theme-heading-color", HeadingColor),
                ("--theme-link", LinkColor),
                ("--theme-link-hover", LinkHoverColor),
                ("--theme-button-bg", ButtonBackground),
                ("--theme-font-family", FontFamily),
                ("--theme-font-size", FontSize),
                ("--theme-line-height", LineHeight),
                ("--theme-heading-font", HeadingFontFamily),
                ("--theme-code-font", CodeFontFamily),
                ("--theme-content-width", ContentMaxWidth),
                ("--theme-gutter", ContentGutter),
                ("--theme-button-radius", ButtonRadius),
                ("--theme-input-radius", InputRadius),
                ("--theme-block-radius", BlockRadius),
            })
                if (!string.IsNullOrWhiteSpace(value)) parts.Add(prop + ":" + value.Trim());
            return parts.Count == 0 ? null : string.Join(";", parts);
        }
    }
}
